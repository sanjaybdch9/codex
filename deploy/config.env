# ── Deployment settings ─────────────────────────────────────────────
# Edit if you like; the defaults are fine for a test deploy.

# AWS / cluster
AWS_REGION="us-east-1"
CLUSTER_NAME="gst-billing"
ECR_REPO="gst-billing"
IMAGE_TAG="v1"
NODE_TYPE="t3.small"
NODE_COUNT="2"

# Kubernetes namespace (matches k8s/*.yaml)
K8S_NAMESPACE="gst-billing"

# App settings — test mode: no custom domain, plain http.
#   "*" allows any address; secure-cookies off so login works over http.
#   For a real domain, set ALLOWED_HOSTS to it and SECURE_COOKIES to "true".
DJANGO_ALLOWED_HOSTS="*"
DJANGO_SECURE_COOKIES="false"
DJANGO_DEBUG="false"
DJANGO_TIME_ZONE="Asia/Kolkata"
